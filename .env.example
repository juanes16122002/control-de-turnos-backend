JWT_SECRET=tu_secreto_aqui
# Sesión del panel: token de acceso corto + renovación automática
JWT_EXPIRES_IN=15m
# La sesión vence si no se usa en estas horas, y dura como máximo estos días desde el login
REFRESH_IDLE_HOURS=12
SESSION_MAX_DAYS=7
ADMIN_USER=admin
ADMIN_PASS=1234
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Supabase → "Connect" → Session pooler (puerto 5432). Para Postgres local:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/turnos
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:[YOUR-PASSWORD]@aws-0-TU-REGION.pooler.supabase.com:5432/postgres

# SSL: automático (require con Supabase, disable en local). Valores: verify | require | disable
# DB_SSL=verify
# DB_SSL_CA_PATH=./certs/prod-ca-2021.crt
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DB_POOL_MAX=10

# Solo para scripts/migrar-a-supabase.js: base de datos de ORIGEN (la actual)
# ORIGEN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/turnos

# Proxies de confianza delante del backend (para que el límite de intentos use la IP real).
# Automático: 1 en Railway, 0 en otro caso. Solo defínelo si tu despliegue es distinto.
# TRUST_PROXY=1
